# Telegram bot token from @BotFather
MJ_TOKEN=
# polling (default, supported) | webhook (the 2022 deploy path — see README, "Deploying (webhook)")
MJ_MODE=polling
# Only needed in webhook mode, e.g. https://your-app.herokuapp.com/
MJ_WEBHOOK_URL=
# 1 = log incoming updates (telebot diagnostics) while testing locally
MJ_DEBUG=1

# Everything else has a working default and is left out here on purpose: the timeouts, the poll hold,
# the reconciliation beat and the write-holding breaker. The one list of them, checked against the code
# by tests/test_docs.py, is the Tuning table in README.md — copy from there rather than from this file.
